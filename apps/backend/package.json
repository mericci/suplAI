{
  "name": "@supl/backend",
  "version": "1.0.0",
  "description": "Supabase backend API with Node.js and TypeScript",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "test": "ts-mocha",
    "test:watch": "mocha --watch",
    "test:coverage": "nyc mocha",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "fmt": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "fmt:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "validate": "npm run fmt:check && npm run lint && npm run type-check && npm run test",
    "clean": "rm -rf dist coverage node_modules"
  },
  "keywords": [
    "supabase",
    "backend",
    "api",
    "typescript",
    "node"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@supabase/supabase-js": "^2.39.3",
    "@supl/shared": "*",
    "axios": "^1.13.5",
    "axios-cookiejar-support": "^6.0.5",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.1",
    "http-errors": "^2.0.1",
    "http-status-codes": "^2.3.0",
    "tough-cookie": "^6.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@faker-js/faker": "^9.9.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/bcrypt": "^5.0.2",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.5",
    "@types/sinon": "^21.0.0",
    "@types/sinon-chai": "^3.2.12",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "chai": "^4.4.1",
    "eslint": "^9.28.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "prettier": "^3.2.4",
    "sinon": "^21.0.1",
    "sinon-chai": "^3.7.0",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsup": "^8.5.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.55.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
